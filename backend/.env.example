# Скопируй этот файл в .env и заполни свои значения
# cp .env.example .env

# --- PostgreSQL (Podman) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medprice

# --- Groq AI (для нормализации услуг) ---
# Получить ключ: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Логирование ---
LOG_LEVEL=INFO
